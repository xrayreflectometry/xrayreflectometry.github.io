---
import PageLayout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '404 — ReflexAuto',
  ignoreTitleTemplate: true,
  description: 'Page not found / 페이지를 찾을 수 없습니다',
  robots: { index: false, follow: true },
};
---

<PageLayout metadata={metadata} lang="en">
  <section class="mx-auto max-w-2xl px-4 sm:px-6 py-24 md:py-32 text-center">
    <p class="font-mono text-sm tracking-[0.2em] text-primary mb-5">ERROR 404</p>
    <h1 class="font-heading text-4xl md:text-5xl font-extrabold tracking-tight text-heading dark:text-white">
      Page not found
    </h1>
    <p class="mt-5 text-lg text-muted">
      This page isn't here — it may have moved.<br />
      <span lang="ko">찾으시는 페이지가 없습니다, 주소가 바뀌었을 수 있습니다</span>
    </p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn-primary text-sm px-6 py-3">Home</a>
      <a href="/ko" class="btn text-sm px-6 py-3" lang="ko">한국어 홈</a>
    </div>
  </section>
</PageLayout>
