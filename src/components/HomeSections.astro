---
import Image from '~/components/common/Image.astro';
import { ui, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const email = 'xray1006.rtx3090@gmail.com';
const ko = lang === 'ko';

const badgeCaption = ko ? '10초 만에 자동 수렴' : 'converged in 10 s';
const benchBadge = ko ? '단일막 / film250.dat' : 'single film — film250.dat';
const winLabel = ko ? '대등하거나 더 나음' : 'matched or beaten';
const outOf = ko ? '20개 시료 중' : 'of 20 samples';
const eyebrowCls =
  'inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.2em] uppercase text-primary mb-3 before:content-[""] before:inline-block before:h-3 before:w-[3px] before:bg-primary';

// Feature designators (mono) + domain line-art (currentColor ink)
const designators = ['FIT', 'SL·16', 'MCMC', 'BATCH', 'TUNE', 'BIN'];
const svgA = [
  `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M7 5V34H36" stroke-width="0.9" opacity="0.5"/><path d="M4 8h3M4 16h3M4 24h3" stroke-width="0.9" opacity="0.5"/><polyline points="8,7 9.5,13 11,8 12.5,15 14,10 15.5,17 17,13 18.5,19 20,16 22,21 24,18.5 26,22 28,20.5 30,22.5 32,21.8 34,22.5" stroke-width="1.5"/><rect x="10.2" y="7.2" width="1.6" height="1.6" stroke-width="0.9"/><rect x="16.2" y="12.2" width="1.6" height="1.6" stroke-width="0.9"/><rect x="23.2" y="17.7" width="1.6" height="1.6" stroke-width="0.9"/></svg>`,
