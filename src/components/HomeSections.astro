        <line x1="60" y1="137.5" x2="1180" y2="137.5" />
        <line x1="60" y1="235" x2="1180" y2="235" />
        <line x1="60" y1="332.5" x2="1180" y2="332.5" />
        <line x1="60" y1="430" x2="1180" y2="430" />
      </g>
      <g fill="currentColor" opacity="0.6" font-family="'IBM Plex Mono','IBM Plex Sans KR',monospace" font-size="15">
        <text x="16" y="44">10⁰</text>
