      <g stroke="currentColor" stroke-width="1" opacity="0.6">
        <line x1="277.9" y1="165" x2="386.8" y2="165" />
        <line x1="277.9" y1="165" x2="277.9" y2="172" />
        <line x1="386.8" y1="165" x2="386.8" y2="172" />
