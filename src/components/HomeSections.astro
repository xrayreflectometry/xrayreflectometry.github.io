  `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6V33H35" stroke-width="0.9" opacity="0.5"/><g stroke-width="1.2"><path d="M11 12v8M9.5 12h3M9.5 20h3"/><path d="M18 16v9M16.5 16h3M16.5 25h3"/><path d="M25 20v8M23.5 20h3M23.5 28h3"/><path d="M31 23v7M29.5 23h3M29.5 30h3"/></g><circle cx="11" cy="16" r="1.1" fill="currentColor" stroke="none"/><circle cx="18" cy="20.5" r="1.1" fill="currentColor" stroke="none"/><circle cx="25" cy="24" r="1.1" fill="currentColor" stroke="none"/><circle cx="31" cy="26.5" r="1.1" fill="currentColor" stroke="none"/></svg>`,
  `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="10" width="20" height="15" stroke-width="1.2" opacity="0.55"/><rect x="10" y="14" width="20" height="15" stroke-width="1.2" opacity="0.75"/><rect x="14" y="18" width="20" height="15" stroke-width="1.4"/><polyline points="16,30 18,26 20,31 22.5,28 25,31.5 28,29.5 31,31 33,30.5" stroke-width="1.3"/></svg>`,
  `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6V33H35" stroke-width="0.9" opacity="0.5"/><path d="M8 12C14 12 15 24 21 24C27 24 27 29 34 29" stroke-width="1.5"/><path d="M8 15C14 15 15 20 21 20" stroke-width="1" opacity="0.4"/><rect x="18.8" y="21.8" width="4.4" height="4.4" stroke-width="1.4"/><path d="M21 18v-4M19.8 15.4l1.2-1.4 1.2 1.4M21 30v3M19.8 31.6l1.2 1.4 1.2-1.4" stroke-width="1" opacity="0.7"/></svg>`,
  `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><g stroke-width="1.1" opacity="0.5"><rect x="5" y="8" width="6" height="5"/><rect x="5" y="17.5" width="6" height="5"/><rect x="5" y="27" width="6" height="5"/></g><path d="M12 10.5C17 10.5 16 20 20 20M12 20H18M12 29.5C17 29.5 16 20 20 20" stroke-width="1" opacity="0.55"/><path d="M18 18.4l2.2 1.6-2.2 1.6" stroke-width="1" opacity="0.55"/><rect x="22" y="12" width="14" height="16" stroke-width="1.6"/><polyline points="25,24 27,20 29,25 31,22 33,24" stroke-width="1.3"/></svg>`,
];
---

<!-- ============ HERO (asymmetric) ============ -->
<section class="relative overflow-hidden">
  <div class="absolute inset-0 reflex-hero-grid pointer-events-none" aria-hidden="true"></div>
  <div class="reflex-hero-art hidden sm:block pointer-events-none absolute inset-0" aria-hidden="true">
    <svg class="h-full w-full" viewBox="0 0 1200 480" fill="none" preserveAspectRatio="xMinYMid slice" xmlns="http://www.w3.org/2000/svg">
      <path d="M60 40V430H1180" stroke="currentColor" stroke-width="1" opacity="0.45" />
