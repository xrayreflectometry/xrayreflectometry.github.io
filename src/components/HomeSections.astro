      <text x="150" y="449" fill="currentColor" opacity="0.7" font-family="'IBM Plex Mono','IBM Plex Sans KR',monospace" font-size="14">q<tspan dy="4" font-size="10">z</tspan><tspan dy="-4"> (&#197;&#8315;&#185;)</tspan></text>
      <polyline class="reflex-fringe" pathLength="1" stroke="var(--aw-color-primary)" stroke-width="1.9" stroke-linejoin="round" stroke-linecap="round" opacity="0.9" points="46.0,40.0 152.2,40.0 152.2,48.7 156.2,52.2 160.1,56.3 164.1,61.2 168.0,66.8 172.0,73.2 176.0,80.3 179.9,88.2 183.9,96.9 187.8,106.5 191.8,117.1 195.7,128.8 199.7,141.6 203.6,155.6 207.6,170.7 211.5,186.7 215.5,202.3 219.4,215.5 223.4,223.2 227.3,223.8 231.3,218.8 235.2,211.4 239.2,203.7 243.2,196.8 247.1,191.1 251.1,186.7 255.0,183.5 259.0,181.5 262.9,180.5 266.9,180.6 270.8,181.5 274.8,183.5 278.7,186.3 282.7,190.0 286.6,194.6 290.6,200.2 294.5,206.8 298.5,214.4 302.4,223.2 306.4,233.1 310.4,244.3 314.3,256.9 318.3,270.5 322.2,284.7 326.2,297.8 330.1,307.2 334.1,310.1 338.0,306.3 342.0,298.4 345.9,289.2 349.9,280.3 353.8,272.6 357.8,266.2 361.7,261.0 365.7,257.1 369.6,254.4 373.6,252.7 377.6,252.0 381.5,252.4 385.5,253.6 389.4,255.8 393.4,259.0 397.3,263.0 401.3,268.1 405.2,274.2 409.2,281.5 413.1,289.9 417.1,299.6 421.0,310.6 425.0,322.8 428.9,336.0 432.9,349.3 436.8,360.4 440.8,366.5 444.8,365.5 448.7,358.8 452.7,349.4 456.6,339.5 460.6,330.5 464.5,322.7 468.5,316.3 472.4,311.1 476.4,307.1 480.3,304.3 484.3,302.5 488.2,301.8 492.2,302.0 496.1,303.1 500.1,305.3 504.0,308.3 508.0,312.4 512.0,317.4 515.9,323.5 519.9,330.8 523.8,339.3 527.8,349.2 531.7,360.3 535.7,372.6 539.6,385.6 543.6,397.9 547.5,406.7 551.5,409.4 555.4,405.2 559.4,396.5 563.3,386.3 567.3,376.4 571.2,367.5 575.2,360.0 579.2,353.7 583.1,348.8 587.1,345.0 591.0,342.3 595.0,340.6 598.9,340.0 602.9,340.3 606.8,341.6 610.8,343.8 614.7,347.0 618.7,351.2 622.6,356.4 626.6,362.8 630.5,370.3 634.5,379.1 638.4,389.3 642.4,400.7 646.4,413.2 650.3,425.8 654.3,436.7 658.2,442.9 662.2,442.1 666.1,435.2 670.1,425.3 674.0,414.9 678.0,405.1 681.9,396.6 685.9,389.4 689.8,383.5 693.8,378.9 697.7,375.4 701.7,372.9 705.6,371.5 709.6,371.1 713.6,371.6 717.5,373.1 721.5,375.6 725.4,379.0 729.4,383.5 733.3,389.0 737.3,395.7 741.2,403.6 745.2,412.8 749.1,423.3 753.1,435.1 757.0,447.6 761.0,459.6 764.9,468.6 768.9,471.6 772.8,467.7 776.8,459.0 780.8,448.4 784.7,438.0 788.7,428.6 792.6,420.5 796.6,413.8 800.5,408.3 804.5,404.0 808.4,400.8 812.4,398.7 816.3,397.6 820.3,397.4 824.2,398.2 828.2,400.0 832.1,402.7 836.1,406.5 840.0,411.3 844.0,417.1 848.0,424.2 851.9,432.5 855.9,442.2 859.8,453.2 863.8,465.2 867.7,474.0 871.7,474.0 875.6,474.0 879.6,474.0 883.5,474.0 887.5,474.0 891.4,467.5 895.4,457.4 899.3,448.4 903.3,440.8 907.2,434.5 911.2,429.4 915.2,425.5 919.1,422.7 923.1,420.9 927.0,420.1 931.0,420.3 934.9,421.4 938.9,423.5 942.8,426.6 946.8,430.7 950.7,435.8 954.7,442.1 958.6,449.6 962.6,458.4 966.5,468.6 970.5,474.0 974.4,474.0 978.4,474.0 982.4,474.0 986.3,474.0 990.3,474.0 994.2,474.0 998.2,474.0 1002.1,474.0 1006.1,474.0 1010.0,465.5 1014.0,458.4 1017.9,452.6 1021.9,447.9 1025.8,444.4 1029.8,442.0 1033.7,440.6 1037.7,440.1 1041.6,440.6 1045.6,442.1 1049.6,444.5 1053.5,447.9 1057.5,452.4 1061.4,458.0 1065.4,464.7 1069.3,472.7 1073.3,474.0 1077.2,474.0 1081.2,474.0 1085.1,474.0 1089.1,474.0 1093.0,474.0 1097.0,474.0 1100.9,474.0 1104.9,474.0 1108.8,474.0 1112.8,474.0 1116.8,474.0 1120.7,474.0 1124.7,474.0 1128.6,468.6 1132.6,464.4 1136.5,461.3 1140.5,459.2 1144.4,458.2 1148.4,458.1 1152.3,458.9 1156.3,460.7 1160.2,463.5 1164.2,467.4 1168.1,472.2 1172.1,474.0 1176.0,474.0 1180.0,474.0" />
    </svg>
  </div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-10 md:pt-14 pb-14 md:pb-20">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-6 items-center">
      <div class="lg:col-span-6" data-reveal-group>
        <span class={eyebrowCls} data-reveal-item>{t.hero.eyebrow}</span>
        <h1
          class="font-heading text-4xl md:text-5xl xl:text-[3.65rem] font-extrabold leading-[1.07] tracking-tight text-heading dark:text-white"
          data-reveal-cell
          set:html={t.hero.title}
        />
        <p class="mt-5 text-lg text-muted max-w-xl leading-relaxed" data-reveal-item set:html={t.hero.subtitle} />
        <div class="mt-7 flex flex-wrap gap-3" data-reveal-item>
          <a href="#pricing" class="btn-primary text-sm px-6 py-3">{t.hero.buy}</a>
          <a href="#how" class="btn text-sm px-6 py-3">{t.hero.how}</a>
        </div>
        <dl
          class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-5 border-t border-gray-200 dark:border-slate-700/70 pt-6"
          data-reveal-item
        >
          {
            t.stats.map((s) => (
              <div>
                <dt
                  class="font-mono text-2xl md:text-[1.7rem] font-bold text-primary leading-none tabular-nums"
                  data-countup={s.amount}
                >
                  {s.amount}
                </dt>
                <dd class="mt-1.5 text-xs text-muted leading-snug">{s.title}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="lg:col-span-6 relative">
        <div class="relative border border-gray-300 dark:border-slate-700 bg-white dark:bg-slate-900">
          <Image
            src="~/assets/images/reflexauto-fit.png"
            alt={t.imageAlt.hero}
            widths={[400, 768, 1024]}
            sizes="(max-width: 1023px) 100vw, 640px"
            width={1024}
            height={600}
            loading="eager"
            fetchpriority="high"
            format="webp"
            class="w-full"
          />
          <div class="flex items-center gap-2 border-t border-gray-200 dark:border-slate-700 bg-page px-3 py-2">
            <span class="inline-block h-3.5 w-[3px] bg-primary" aria-hidden="true" />
            <span class="font-mono text-xs font-bold text-heading dark:text-white">FOM 0.022</span>
            <span class="font-mono text-[11px] text-muted">{badgeCaption}</span>
          </div>
          <span class="absolute -top-px -left-px h-3 w-3 border-t-2 border-l-2 border-primary" aria-hidden="true" />
          <span class="absolute -top-px -right-px h-3 w-3 border-t-2 border-r-2 border-primary" aria-hidden="true" />
          <span class="absolute -bottom-px -left-px h-3 w-3 border-b-2 border-l-2 border-primary" aria-hidden="true" />
          <span class="absolute -bottom-px -right-px h-3 w-3 border-b-2 border-r-2 border-primary" aria-hidden="true" />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ FEATURES — Spec Plate ============ -->
<section id="features" class="py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="max-w-2xl mb-8">
      <span class={eyebrowCls}>{t.features.tagline}</span>
      <h2 class="font-heading text-3xl md:text-4xl font-extrabold tracking-tight text-heading dark:text-white">
        {t.features.title}
      </h2>
      <p class="mt-4 text-lg text-muted">{t.features.subtitle}</p>
    </div>
    <div class="relative border border-gray-300 dark:border-slate-700">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-gray-200 dark:bg-slate-800">
        {
          t.features.items.map((f, i) => (
            <div class="bg-page p-6 md:p-7">
              <div class="flex items-center gap-2 mb-4">
                <span class="inline-block h-3.5 w-[3px] bg-primary" aria-hidden="true" />
                <span class="font-mono text-[11px] tracking-[0.18em] text-muted">{designators[i]}</span>
              </div>
              <span
                aria-hidden="true"
                class="block shrink-0 w-11 h-11 mb-4 text-heading dark:text-slate-200 [&>svg]:w-full [&>svg]:h-full"
                set:html={svgA[i]}
              />
              <h3 class="text-base font-bold text-heading dark:text-white">{f.title}</h3>
              <p class="text-sm text-muted mt-1.5 leading-relaxed">{f.description}</p>
            </div>
          ))
        }
      </div>
      <span class="absolute -top-px -left-px h-3 w-3 border-t-2 border-l-2 border-primary" aria-hidden="true" />
      <span class="absolute -top-px -right-px h-3 w-3 border-t-2 border-r-2 border-primary" aria-hidden="true" />
      <span class="absolute -bottom-px -left-px h-3 w-3 border-b-2 border-l-2 border-primary" aria-hidden="true" />
      <span class="absolute -bottom-px -right-px h-3 w-3 border-b-2 border-r-2 border-primary" aria-hidden="true" />
    </div>
  </div>
</section>

<!-- ============ HARD CASES (asymmetric image left) ============ -->
<section class="py-16 md:py-24 bg-gray-100/70 dark:bg-white/[0.02]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <div class="lg:col-span-7 order-2 lg:order-1">
        <div class="relative border border-gray-300 dark:border-slate-700 overflow-hidden bg-white dark:bg-slate-900">
          <Image
            src="~/assets/images/reflexauto-superlattice.png"
            alt={t.imageAlt.hard}
            widths={[400, 768, 1024]}
            sizes="(max-width: 1023px) 100vw, 720px"
            width={970}
            height={858}
            format="webp"
            class="w-full"
          />
          <span class="absolute -top-px -left-px h-3 w-3 border-t-2 border-l-2 border-primary" aria-hidden="true" />
          <span class="absolute -top-px -right-px h-3 w-3 border-t-2 border-r-2 border-primary" aria-hidden="true" />
          <span class="absolute -bottom-px -left-px h-3 w-3 border-b-2 border-l-2 border-primary" aria-hidden="true" />
          <span class="absolute -bottom-px -right-px h-3 w-3 border-b-2 border-r-2 border-primary" aria-hidden="true" />
        </div>
      </div>
      <div class="lg:col-span-5 order-1 lg:order-2">
        <span class={eyebrowCls}>{t.hard.tagline}</span>
        <h2 class="font-heading text-3xl md:text-4xl font-extrabold tracking-tight text-heading dark:text-white">
          {t.hard.title}
        </h2>
        <p class="mt-4 text-muted" set:html={t.hard.contentBody} />
        <ul class="mt-7 space-y-5">
          {
            t.hard.items.map((it) => (
              <li class="flex gap-3">
                <span class="mt-1.5 inline-block h-3.5 w-[3px] bg-primary shrink-0" aria-hidden="true" />
                <div>
                  <div class="font-semibold text-heading dark:text-white">{it.title}</div>
                  <div class="text-sm text-muted mt-0.5">{it.description}</div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ============ HOW IT WORKS (datasheet steps) ============ -->
<section id="how" class="py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="max-w-2xl mb-10 md:mb-14">
      <span class={eyebrowCls}>{t.steps.tagline}</span>
      <h2 class="font-heading text-3xl md:text-4xl font-extrabold tracking-tight text-heading dark:text-white">
        {t.steps.title}
      </h2>
    </div>
    <div class="relative border border-gray-300 dark:border-slate-700">
      <div class="grid md:grid-cols-3 gap-px bg-gray-200 dark:bg-slate-800">
        {
          t.steps.items.map((s, i) => (
            <div class="bg-page p-6 md:p-7">
              <div class="flex items-center justify-between mb-5">
                <div class="flex items-center gap-2">
                  <span class="inline-block h-3.5 w-[3px] bg-primary" aria-hidden="true" />
                  <span class="font-mono text-[11px] tracking-[0.18em] text-muted">STEP</span>
                </div>
                <span
                  class="font-mono text-3xl font-bold text-gray-300 dark:text-slate-700 leading-none"
                  aria-hidden="true"
                >
                  0{i + 1}
                </span>
              </div>
              <h3 class="text-lg font-bold text-heading dark:text-white">{s.title}</h3>
              <p class="mt-2 text-sm text-muted leading-relaxed">{s.description}</p>
            </div>
          ))
        }
      </div>
      <span class="absolute -top-px -left-px h-3 w-3 border-t-2 border-l-2 border-primary" aria-hidden="true" />
      <span class="absolute -top-px -right-px h-3 w-3 border-t-2 border-r-2 border-primary" aria-hidden="true" />
      <span class="absolute -bottom-px -left-px h-3 w-3 border-b-2 border-l-2 border-primary" aria-hidden="true" />
      <span class="absolute -bottom-px -right-px h-3 w-3 border-b-2 border-r-2 border-primary" aria-hidden="true" />
    </div>
  </div>
</section>

<!-- ============ BENCHMARK (19/20 infographic) ============ -->
<section id="benchmarks" class="py-16 md:py-24 bg-gray-100/70 dark:bg-white/[0.02]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div>
        <span class={eyebrowCls}>{t.bench.tagline}</span>
        <h2 class="font-heading text-3xl md:text-4xl font-extrabold tracking-tight text-heading dark:text-white">
          {t.bench.title}
        </h2>
        <div class="mt-8 flex items-end gap-3">
          <span
            class="font-mono text-7xl font-extrabold text-primary leading-none tabular-nums inline-block text-right min-w-[1.2em]"
            data-countup="19">19</span
          >
          <span class="text-2xl text-muted mb-1">/ 20</span>
          <span class="ml-2 mb-2 text-sm font-medium text-muted">
            {winLabel}
            <br />
            {outOf}
          </span>
        </div>
        <div class="mt-6 grid grid-cols-10 gap-2 max-w-xs" aria-hidden="true" data-bench-grid>
          {
            Array.from({ length: 20 }).map((_, i) => (
              <span
                {...(i < 19 ? { 'data-fill': '' } : {})}
                class:list={['h-3.5 w-3.5', i < 19 ? 'bg-primary' : 'border-2 border-gray-300 dark:border-slate-600']}
              />
            ))
          }
        </div>
        <p class="mt-6 text-muted max-w-md">{t.bench.items[0].description}</p>
        <div class="mt-8 grid sm:grid-cols-2 gap-5">
          {
            t.bench.items.slice(1).map((it) => (
              <div class="border-l-2 border-primary/30 pl-4">
                <h3 class="font-semibold text-heading dark:text-white text-sm">{it.title}</h3>
                <div class="text-sm text-muted mt-1" set:html={it.description} />
              </div>
            ))
          }
        </div>
      </div>
      <div class="relative border border-gray-300 dark:border-slate-700 overflow-hidden bg-white dark:bg-slate-900">
        <Image
          src="~/assets/images/reflexauto-benchmark.png"
          alt={t.imageAlt.bench}
          widths={[400, 768, 1024]}
          sizes="(max-width: 1023px) 100vw, 620px"
          width={932}
          height={840}
          format="webp"
          class="w-full"
        />
        <div class="flex items-center gap-2 border-t border-gray-200 dark:border-slate-700 bg-page px-3 py-2">
          <span class="inline-block h-3.5 w-[3px] bg-primary" aria-hidden="true" />
          <span class="font-mono text-[11px] text-muted">{benchBadge}</span>
        </div>
        <span class="absolute -top-px -left-px h-3 w-3 border-t-2 border-l-2 border-primary" aria-hidden="true" />
        <span class="absolute -top-px -right-px h-3 w-3 border-t-2 border-r-2 border-primary" aria-hidden="true" />
        <span class="absolute -bottom-px -left-px h-3 w-3 border-b-2 border-l-2 border-primary" aria-hidden="true" />
        <span class="absolute -bottom-px -right-px h-3 w-3 border-b-2 border-r-2 border-primary" aria-hidden="true" />
      </div>
    </div>
  </div>
</section>

<!-- ============ PRICING — Spec Plate ============ -->
<section id="pricing" class="py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="max-w-2xl mb-8">
      <span class={eyebrowCls}>{t.pricing.tagline}</span>
      <h2 class="font-heading text-3xl md:text-4xl font-extrabold tracking-tight text-heading dark:text-white">
        {t.pricing.title}
      </h2>
      <p class="mt-4 text-lg text-muted">{t.pricing.subtitle}</p>
    </div>
    <div class="relative border border-gray-300 dark:border-slate-700">
      <div class="grid md:grid-cols-3 gap-px bg-gray-200 dark:bg-slate-800">
        {
          t.pricing.prices.map((p) => (
            <div class="bg-page p-6 lg:p-8 flex flex-col">
              <div class="flex items-center justify-between gap-2 mb-1">
                <div class="flex items-center gap-2">
                  <span class="inline-block h-3.5 w-[3px] bg-primary" aria-hidden="true" />
                  <h3 class="font-mono text-[11px] font-normal tracking-[0.18em] text-muted uppercase">{p.title}</h3>
                </div>
                {'ribbon' in p && p.ribbon && (
                  <span class="font-mono text-[10px] tracking-[0.15em] text-primary border border-primary/40 px-1.5 py-0.5">
                    {p.ribbon}
                  </span>
                )}
              </div>
              <p class="text-sm text-muted mb-5">{p.subtitle}</p>
              <div class="mb-6 flex items-baseline gap-2">
                <span class="font-heading text-4xl font-extrabold text-heading dark:text-white">${p.price}</span>
                <span class="font-mono text-xs text-muted">{p.period}</span>
              </div>
              <ul class="space-y-2.5 mb-8 flex-1">
                {p.items.map((it) => (
                  <li class="flex gap-2.5 text-sm">
                    <span class="mt-1.5 inline-block h-2.5 w-[3px] bg-primary shrink-0" aria-hidden="true" />
                    <span class="text-default dark:text-slate-300">{it}</span>
                  </li>
                ))}
              </ul>
              <a
                href={`mailto:${email}?subject=${encodeURIComponent(p.subject)}`}
                class:list={['justify-center text-sm', 'ribbon' in p && p.ribbon ? 'btn-primary' : 'btn']}
              >
                {p.cta}
              </a>
            </div>
          ))
        }
      </div>
      <span class="absolute -top-px -left-px h-3 w-3 border-t-2 border-l-2 border-primary" aria-hidden="true" />
      <span class="absolute -top-px -right-px h-3 w-3 border-t-2 border-r-2 border-primary" aria-hidden="true" />
      <span class="absolute -bottom-px -left-px h-3 w-3 border-b-2 border-l-2 border-primary" aria-hidden="true" />
      <span class="absolute -bottom-px -right-px h-3 w-3 border-b-2 border-r-2 border-primary" aria-hidden="true" />
    </div>
  </div>
</section>

<!-- ============ FAQ — Spec Plate ============ -->
<section id="faq" class="py-16 md:py-24 bg-gray-100/70 dark:bg-white/[0.02]">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="mb-8">
      <h2 class="font-heading text-3xl md:text-4xl font-extrabold tracking-tight text-heading dark:text-white">
        {t.faq.title}
      </h2>
    </div>
    <dl class="border-t border-gray-200 dark:border-slate-800">
      {
        t.faq.items.map((f) => (
          <div class="border-b border-gray-200 dark:border-slate-800 py-5">
            <dt class="flex gap-2.5">
              <span class="mt-1.5 inline-block h-3.5 w-[3px] bg-primary shrink-0" aria-hidden="true" />
              <span class="font-semibold text-heading dark:text-white">{f.title}</span>
            </dt>
            <dd class="mt-2 ml-[14px] text-muted">{f.description}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<!-- ============ CTA (dark band) ============ -->
<section class="py-16 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="relative overflow-hidden bg-dark dark:bg-white/[0.04] border border-slate-700 px-6 py-12 md:px-14 md:py-16">
      <div class="reflex-hero-grid absolute inset-0 opacity-60" aria-hidden="true"></div>
      <span class="absolute top-0 left-0 h-3 w-3 border-t-2 border-l-2 border-primary" aria-hidden="true"></span>
      <span class="absolute top-0 right-0 h-3 w-3 border-t-2 border-r-2 border-primary" aria-hidden="true"></span>
      <span class="absolute bottom-0 left-0 h-3 w-3 border-b-2 border-l-2 border-primary" aria-hidden="true"></span>
      <span class="absolute bottom-0 right-0 h-3 w-3 border-b-2 border-r-2 border-primary" aria-hidden="true"></span>
      <div class="relative grid md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-8 dark">
          <h2 class="font-heading text-3xl md:text-4xl font-extrabold tracking-tight text-white">{t.cta.title}</h2>
          <p class="mt-4 text-lg text-slate-300 max-w-2xl" set:html={t.cta.subtitle} />
        </div>
        <div class="md:col-span-4 flex flex-col sm:flex-row md:flex-col gap-3">
          <a href="#pricing" class="btn-primary justify-center text-sm px-6 py-3">{t.cta.buy}</a>
          <a
            href={`mailto:${email}?subject=ReflexAuto`}
            class="btn justify-center text-sm px-6 py-3 text-white border-slate-500 hover:bg-slate-800"
          >
            {t.cta.email}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
