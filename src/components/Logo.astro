---
import { SITE } from 'astrowind:config';
---

<span
  class="self-center flex items-center gap-2 text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white font-heading"
>
  <svg
    width="26"
    height="26"
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="shrink-0"
    aria-hidden="true"
  >
    <rect width="24" height="24" rx="6" fill="var(--aw-color-primary)"></rect>
    <polyline
      points="3,7 5,17.5 7,8.5 9,15.5 11,10.5 13,14 15,11.5 17,13 19,12 21,12.5"
      fill="none"
      stroke="#fff"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"></polyline>
  </svg>
  <span>Reflex<span class="text-primary">Auto</span></span>
</span>
