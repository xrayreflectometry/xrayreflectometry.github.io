---
import type { Lang } from '~/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;

const groupLabel = lang === 'ko' ? '언어 선택' : 'Language';
const base = 'px-3 py-2 min-h-[40px] inline-flex items-center text-xs font-semibold tracking-wide transition';
const active = 'bg-primary text-white dark:bg-[#25639b]';
const idle = 'text-muted hover:text-primary';
---

<div
  class="inline-flex items-center rounded-md border border-gray-300 dark:border-slate-600 [&>a:first-child]:rounded-l-[5px] [&>a:last-child]:rounded-r-[5px]"
  role="group"
  aria-label={groupLabel}
>
  <a
    href="/"
    lang="en"
    aria-label="English (EN)"
    class:list={[base, lang === 'en' ? active : idle]}
    aria-current={lang === 'en' ? 'page' : undefined}>EN</a
  >
  <a
    href="/ko"
    lang="ko"
    aria-label="한국어 (KO)"
    class:list={[base, lang === 'ko' ? active : idle]}
    aria-current={lang === 'ko' ? 'page' : undefined}>KO</a
  >
</div>
